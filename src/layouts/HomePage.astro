---
import type { CollectionEntry } from 'astro:content';

import AppCards from '../components/AppCards.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import BaseLayout from './BaseLayout.astro';
import { appText } from '../config/appText';
import { site, type LanguageCode } from '../config/site';
import { homePath } from '../config/routes';
import { appPagesIn } from '../lib/appPages';
import { homeAlternates } from '../lib/hreflang';
import { organization } from '../lib/structuredData';

interface Props {
  entry: CollectionEntry<'home'>;
}

const { entry } = Astro.props;
const data = entry.data;
const { alternates, xDefaultUrl } = await homeAlternates();

// Only the apps that have a page in this language.
const appPages = await appPagesIn(entry.id);
const text = appText[entry.id as LanguageCode];
---

<BaseLayout
    title={data.title}
    description={data.description}
    language={data.language}
    languageCode={data.language_code}
    path={homePath(entry.id)}
    alternateLanguages={alternates}
    xDefaultUrl={xDefaultUrl}
    themeColor={data.theme_color}
    structuredData={[organization()]}
>
    <div class="page">
        <div id="home">
            <LanguageSwitcher items={alternates} />
            <div class="home-hero">
                <p class="home-logo">
                    <img src="/images/logo.png" alt={`${site.name} logo`} title={site.name}>
                </p>
                <p class="eyebrow">{site.name}</p>
                <h1>{data.home_heading}</h1>
                <p class="home-intro">{data.home_intro}</p>
                <p class="home-lead">{data.home_lead}</p>
                <a class="contact-link" href={`mailto:${site.contact.email}`}>{site.contact.email} <span aria-hidden="true">↗</span></a>
            </div>

            <AppCards heading={text.appsHeading} pages={appPages} />
        </div>
    </div>
</BaseLayout>
