---
import { render, type CollectionEntry } from 'astro:content';

import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import BaseLayout from './BaseLayout.astro';
import { site } from '../config/site';
import { appOf, languageOf, privacyPath, resourcesPath } from '../config/routes';
import { appResourcesFor } from '../config/resources';
import { resourceText } from '../config/resourceText';
import type { LanguageCode } from '../config/site';
import { privacyAlternates } from '../lib/hreflang';

interface Props {
  entry: CollectionEntry<'privacy'>;
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const { alternates, xDefaultUrl } = await privacyAlternates(entry.id);

const app = appOf(entry.id);
const language = languageOf(entry.id) as LanguageCode;
// Linked only where that page exists, so a policy added in a language the resource
// list does not cover yet cannot produce a dead link.
const hasResources = appResourcesFor(app)?.languages.includes(language) ?? false;
---

<BaseLayout
    title={data.title}
    description={data.description}
    language={data.language}
    languageCode={languageOf(entry.id)}
    path={privacyPath(entry.id)}
    alternateLanguages={alternates}
    xDefaultUrl={xDefaultUrl}
    themeColor={data.theme_color}
>
    <div class:list={["page", "privacy-page", { "has-switcher": alternates.length > 1 }]}>
        <LanguageSwitcher items={alternates} />

        <h1>{data.title}</h1>

        <div class="policy-meta">
            <p><strong>{data.effective_date_label}:</strong> {data.effective_date}</p>
            <p><strong>{data.last_updated_label}:</strong> {data.last_updated}</p>
        </div>

        <section class="controller-block">
            <h2>{data.controller_title}</h2>
            <p><strong>{data.name_label}:</strong> {site.contact.name}</p>
            <p><strong>{data.email_label}:</strong> <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        </section>

        <Content />

        {hasResources && (
        <p class="page-crosslink">
            <a href={resourcesPath(app, language)}>{resourceText[language].heading}</a>
        </p>
        )}
    </div>
</BaseLayout>
