---
import { getCollection } from 'astro:content';

import HomePage from '../../layouts/HomePage.astro';
import { isDefaultLanguage } from '../../config/routes';

export async function getStaticPaths() {
  const pages = await getCollection('home');
  // The default language is served from the site root by src/pages/index.astro.
  return pages
    .filter((page) => !isDefaultLanguage(page.id))
    .map((page) => ({ params: { lang: page.id }, props: { entry: page } }));
}

const { entry } = Astro.props;
---

<HomePage entry={entry} />
