---
import { getEntry } from 'astro:content';

import SitePrivacyPage from '../../layouts/SitePrivacyPage.astro';
import { DEFAULT_LANGUAGE } from '../../config/routes';

const entry = await getEntry('sitePrivacy', DEFAULT_LANGUAGE);
if (!entry) {
  throw new Error(`Missing src/content/site-privacy/${DEFAULT_LANGUAGE}.md for the default language.`);
}
---

<SitePrivacyPage entry={entry} />
